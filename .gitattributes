# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# C# and .NET project files
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf

# Data and configurations
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.pck binary
*.dll binary
*.exe binary
*.pdb binary
